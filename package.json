{
  "name": "hintlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HintLab — a debugging tutor for programming labs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:runner": "tsx scripts/check-runner.ts",
    "check:agent": "tsx scripts/check-agent.ts",
    "check:web": "tsx scripts/check-web.ts"
  },
  "dependencies": {
    "@cline/sdk": "^0.0.90",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
